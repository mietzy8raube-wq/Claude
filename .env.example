# =============================================================================
# GF-Suite – Umgebungsvariablen
# Kopieren Sie diese Datei nach ".env" und tragen Sie die tatsächlichen Werte
# ein. Die .env-Datei wird nie eingecheckt (siehe .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Datenbank (PostgreSQL)
# -----------------------------------------------------------------------------
# Format: postgresql://BENUTZER:PASSWORT@HOST:PORT/DATENBANK?schema=public
DATABASE_URL="postgresql://gfsuite:CHANGE_ME@localhost:5432/gfsuite?schema=public"

# -----------------------------------------------------------------------------
# Auth.js (NextAuth)
# -----------------------------------------------------------------------------
# Geheimer Schlüssel zur Signierung von Sessions/JWTs.
# Erzeugen mit: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_32_BYTE_RANDOM_STRING"

# Basis-URL der Anwendung (in Produktion: https://ihre-domain.tld)
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Microsoft Entra ID / Microsoft Graph (Outlook-Integration)
# Leer lassen, um die Anwendung ohne Outlook-Integration zu betreiben —
# alle übrigen Funktionen (Aufgaben, Projekte, Excel, ...) funktionieren
# dann unverändert. Siehe README.md "Entra-ID-App-Registrierung" für die
# Schritt-für-Schritt-Einrichtung.
# -----------------------------------------------------------------------------
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Muss exakt mit der in Entra ID hinterlegten Redirect-URI übereinstimmen.
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/integrations/microsoft/callback"

# -----------------------------------------------------------------------------
# Verschlüsselung
# -----------------------------------------------------------------------------
# Base64-kodierter 32-Byte-Schlüssel (AES-256-GCM) zur Verschlüsselung der
# gespeicherten Microsoft-Graph-Tokens (Access-/Refresh-Token) in der
# Datenbank. Erzeugen mit: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="CHANGE_ME_BASE64_32_BYTE_KEY"
