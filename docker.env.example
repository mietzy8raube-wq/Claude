# =============================================================================
# GF-Suite – Umgebungsvariablen für die Docker-Compose-Bereitstellung
# Kopieren Sie diese Datei nach ".env" (gleiches Verzeichnis wie
# docker-compose.yml). Diese Datei ist NICHT dieselbe wie ".env.example"
# (das ist für den lokalen Entwicklungsbetrieb ohne Docker, siehe README).
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (Datenbank-Container)
# -----------------------------------------------------------------------------
POSTGRES_USER=gfsuite
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=gfsuite

# -----------------------------------------------------------------------------
# Auth.js (NextAuth)
# -----------------------------------------------------------------------------
# Geheimer Schlüssel zur Signierung von Sessions/JWTs.
# Erzeugen mit: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_32_BYTE_RANDOM_STRING

# Adresse, unter der die App im internen Netz erreichbar ist, z. B.
# http://192.168.1.50:3000 oder http://gfsuite.intern:3000
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Verschlüsselung gespeicherter Microsoft-Graph-Tokens (AES-256-GCM)
# -----------------------------------------------------------------------------
# Base64-kodierter 32-Byte-Schlüssel. Erzeugen mit: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

# -----------------------------------------------------------------------------
# Port, unter dem die App auf dem Server erreichbar ist
# -----------------------------------------------------------------------------
APP_PORT=3000

# -----------------------------------------------------------------------------
# Optional: Microsoft Entra ID / Outlook-Integration
# Leer lassen, um ohne Outlook-Integration zu betreiben (siehe README
# "Entra-ID-App-Registrierung" für die Einrichtung).
# -----------------------------------------------------------------------------
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Optional: nur für die Erstinbetriebnahme, siehe DEPLOYMENT.md
# ("npm run user:create" im App-Container legt damit das erste Konto an).
# Danach nicht mehr benötigt.
# -----------------------------------------------------------------------------
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ROLE=GESCHAEFTSFUEHRER
