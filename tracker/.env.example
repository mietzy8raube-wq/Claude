# ---------------------------------------------------------------
# GF Tracker – Konfiguration. Kopieren nach ".env" und anpassen.
# ---------------------------------------------------------------

# Öffentliche Adresse (für Links in E-Mails und das Kundenportal)
APP_URL=https://tracker.ihre-firma.de
# Domain für das HTTPS-Zertifikat (Caddy) – muss per DNS auf den Server zeigen
DOMAIN=tracker.ihre-firma.de
# Name im Kundenportal und in E-Mails
COMPANY_NAME=Ihre Firma GmbH

# Erster Administrator (wird nur beim allerersten Start angelegt).
# ADMIN_PASSWORD leer lassen = zufälliges Passwort, steht dann einmalig im Log.
ADMIN_EMAIL=admin@ihre-firma.de
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# Optional: E-Mail-Versand über Microsoft 365 (siehe ARCHITEKTUR.md, Abschnitt 8)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MAIL_SENDER=service@ihre-firma.de

# Optional
# BACKUP_KEEP=14        # Anzahl aufbewahrter Tagessicherungen
# SEED_DEMO=1           # Beispieldaten beim ersten Start (nur zum Ausprobieren!)
# PORT=3000
