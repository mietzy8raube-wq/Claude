# ---------------------------------------------------------------
# GF Tracker – Konfiguration. Kopieren nach ".env" und anpassen.
# ---------------------------------------------------------------

# Öffentliche Adresse (für Links in E-Mails und das Kundenportal)
APP_URL=https://tracker.ihre-firma.de
# Domain für das HTTPS-Zertifikat (Caddy) – muss per DNS auf den Server zeigen
DOMAIN=tracker.ihre-firma.de
# Name im Kundenportal und in E-Mails
COMPANY_NAME=Ihre Firma GmbH

# Erster Administrator (wird nur beim allerersten Start angelegt).
# ADMIN_PASSWORD leer lassen = zufälliges Passwort, steht dann einmalig im Log.
ADMIN_EMAIL=admin@ihre-firma.de
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# Optional: Microsoft 365 über eine App-Registrierung in Entra ID
# (siehe ARCHITEKTUR.md, Abschnitte 8 und 13.3 – oder Einstellungen → Integrationen)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Absender für E-Mails (Recht Mail.Send)
MAIL_SENDER=service@ihre-firma.de
# Service-Postfach: E-Mails werden zu Vorgängen (Recht Mail.ReadWrite) – auch unter Integrationen einstellbar
# MAIL_INBOX=service@ihre-firma.de
# Anmeldung mit Microsoft anbieten (Umleitungs-URI: APP_URL/auth/microsoft/callback)
# SSO_MICROSOFT=1
# Termindauer im Outlook-Kalender in Minuten
# CALENDAR_EVENT_MINUTES=120

# Optional: Factorial HR (Mitarbeiter und Abwesenheiten, stündlicher Abgleich)
# FACTORIAL_API_KEY=
# FACTORIAL_API_VERSION=2026-10-01

# Zeitzone für Termine und E-Mails
# TZ=Europe/Berlin

# Optional
# BACKUP_KEEP=14        # Anzahl aufbewahrter Tagessicherungen
# SEED_DEMO=1           # Beispieldaten beim ersten Start (nur zum Ausprobieren!)
# PORT=3000

# Optional: Kundenportal auf Ihrer Website per <iframe> einbetten (Adresse(n) der Website)
# PORTAL_FRAME_ANCESTORS=https://www.ihre-firma.de
